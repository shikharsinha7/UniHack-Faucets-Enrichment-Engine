# Copy this file to .env and fill in your real keys. Never commit .env.

# Gemini API key (aistudio.google.com/apikey) - free, no card required
GEMINI_API_KEY=your_gemini_key_here

# Tavily API key (tavily.com) - free tier
TAVILY_API_KEY=your_tavily_key_here

# Optional - defaults to local SQLite if not set. Set this to a
# postgresql:// URL (e.g. from Supabase) to use Postgres instead.
DATABASE_URL=
